    selected_details = gui_text_area("Select an object in science or weapons to view details.")

    gm = get_inventory_value(client_id, "GAMEMASTER_COMBOT", None)

    on change get_inventory_value(gm, "gamemaster_prev_selection"):
        # if not selected_details.is_hidden:
        details_text = gm_selected_object_details(gm)
        selected_details.update(details_text)
    yield success

