=== gm_remove_selected_fleet_ship
    default __ITEM__ = None
    default fleet_name = None
    default fleet_ships = []
    item = __ITEM__
    if item is None:
        yield fail
    ship_data = item.data
    ship_id = ship_data.get("ship_id") if ship_data is not None else None
    if ship_id is not None:
        fleet_remove_ship(ship_id)
        await task_schedule(build_new_fleet_for_ship,{"ship_id":ship_id})
        fleet_list = gui_get_variable("gm_selected_fleet_list")
        gm = get_inventory_value(client_id, "GAMEMASTER_COMBOT", None)
        selected = get_inventory_value(gm, "gamemaster_prev_selection", None)
        fleet_name, fleet_ships = gm_selected_fleet_data(selected)
        if fleet_list is not None:
            fleet_list.items = fleet_ships
            gui_represent(fleet_list)
    yield success



=== build_new_fleet_for_ship
metadata: ```yaml
ship_id:
```
    yield fail if ship_id is None
    old_fleet = get_inventory_value(ship_id, "my_fleet_id")
    fleet_remove(old_fleet, ship_id)

    pos = get_pos(ship_id)
    role_list = get_role_string(ship_id)
    
    fleet = fleet_spawn(pos, role_list)
    fleet.side = to_object(old_fleet).side
    fleet_add(fleet, ship_id)

