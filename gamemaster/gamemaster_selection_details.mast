=== gm_add_or_remove_torp
    print("Adding or removing torp")
    if __ITEM__ is not None:
        torp = __ITEM__.data.get("torp_item")
        yield fail if torp is None
        key = torp.get("key",0)
        ship = torp.get("ship",None)
        add = __ITEM__.data.get("add", True)
        if ship is None:
            yield fail
        print("Item not none")
        cur = get_data_set_value(ship, "{key}_NUM",0)
        if add:
            cur += 1
            _max = get_data_set_value(ship, "{key}_MAX",0)
            if cur > _max:
                cur = _max
        else:
            cur -= 1
            if cur < 0:
                cur = 0
        set_data_set_value(ship, "{key}_NUM", cur)
        yield success
    yield fail

=== gm_change_torp_capacity
" Change the max capacity of the specified torpedo for the selected ship.
" Uses a modifier to be compatible with other sources of capacity increases/decreases.
    print("Changing torp cap")
    if __ITEM__ is not None:
        data = __ITEM__.data
        key = data.get("key")
        yield fail if key is None
        ship = data.get("ship")
        if ship is None:
            yield fail
        print("Item not none")
        add = data.get("add",True)
        count = 1 if add else -1
        exists = modifier_exists(ship, "GM")
        cur_mods = modifiers_get_for_object(ship, "{key}_MAX")
        for c in cur_mods:
            if c.source == "GM":
                count = c.value + count
        modifier_add(ship, "{key}_MAX", count, "GM", 0, replace_if_exists=True)
        yield success
    yield fail

#endregion


=== gm_selected_fleet
metadata: ``` yaml
type: gm_menu/selected/fleet
icon_index: 105
priority: 110
```
    gm = get_inventory_value(client_id, "GAMEMASTER_COMBOT", None)
    selected = get_inventory_value(gm, "gamemaster_prev_selection", None)
    default fleet_name = None
    default fleet_ships = []
    fleet_name, fleet_ships = gm_selected_fleet_data(selected)

    gui_row("row-height: 1.5em;")
    fleet_title = gui_text("$text:No fleet for the selected ship.;font:gui-2;")
    gui_row("row-height: content;")
    fleet_list = gui_list_box(fleet_ships, "background:#1572;", item_template=gm_selected_fleet_ship_template, select=True)
    gui_set_variable("gm_selected_fleet_list", fleet_list)
    on change get_inventory_value(gm, "gamemaster_prev_selection", None):
        selected = get_inventory_value(gm, "gamemaster_prev_selection", None)
        fleet_name, fleet_ships = gm_selected_fleet_data(selected)
        fleet_list = gui_get_variable("gm_selected_fleet_list")
        if fleet_name is None:
            fleet_title.update("text:No fleet for the selected ship.;font:gui-2;")
        else:
            fleet_title.update("text:Fleet: " + gui_text_escape(fleet_name) + ";font:gui-2;")
        if fleet_list is None:
            print("WARNING: gm selection details - fleet_list is None")
        else:
            fleet_list.items = fleet_ships


    yield success

