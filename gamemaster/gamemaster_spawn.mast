    with gui_sub_section("background-color: #95357d22;"):
        gui_row("row-height: 1.5em;")
        gui_text("Nebula Spawn Settings")
        gui_row("row-height: 0.5em; background-color: #122048;")
        gui_blank()

        gui_row("row-height: 1.5em;")
        gui_text("$text:Density;")
        nebula_use_default_density = gui_checkbox("$text:Use Default;")

        gui_row("row-height: 1.5em;")
        nebula_density = gui_slider("low:0;high:100;text:int;")

        gui_row("row-height: 1.5em;")
        color_list = ["purple","red","blue","yellow","green","orange","white","custom"]
        nebula_color_dd = gui_drop_down(f"$text:purple;list:{','.join(color_list)};")
        
        gui_row("row-height: 1.5em;")
        on gui_message(gui_button("Test DD")):
            nebula_color_dd.value = "#123456"

        gui_row("row-height: 1.5em;")
        gui_text("$text:Shape:;","col-width: content;")

        nebula_prefabs = labels_get_type("prefab/terrain/nebula")

        gui_row()
        nebula_shape_list = gui_list(nebula_prefabs, select=True)
        with nebula_shape_list as prefab:
            display_text = prefab.get_inventory_value("display_text")
            if display_text is None:
                display_text = prefab.get_inventory_value("type").replace("prefab/terrain/","").replace("asteroid/","").replace("nebula/","")
            gui_text(f"$text:{display_text}")
        nebula_shape_list.set_selected_index(0)

        gui_row("row-height: 1.5em;")
        neb_use_marker = gui_checkbox("$text:Use Marker;")
        gui_row("row-height: 1.5em;")
        nebula_name_input = gui_input("$text:;desc:Nebulae Name;")
        
        gui_row("row-height: 1.5em;")
        spawn_nebula_button = gui_button("$text:Spawn Nebulae")

        on gui_message(spawn_nebula_button):
            gm = sbs.get_ship_of_client(client_id)
            pos = gamemaster_get_pos(gm)
            size = int(gamemaster_get_size(gm))
            neb_color = nebula_color_dd.value
            lbl = nebula_shape_list.listbox.value
            neb_name = nebula_name_input.value
            if not nebula_use_default_density.value:
                data={"density_scale":nebula_density.value,"START_X":pos.x,"START_Y":pos.y,"START_Z":pos.z,"SIZE_X":size,"SIZE_Z":size, "cluster_color":neb_color, "marker": neb_use_marker.value, "name": neb_name}
            else:
                data={"START_X":pos.x,"START_Y":pos.y,"START_Z":pos.z,"SIZE_X":size,"SIZE_Z":size, "cluster_color":neb_color, "marker": neb_use_marker.value, "name": neb_name}
            prefab_spawn(lbl, data=data)

    yield success


