    with gui_sub_section():
        gui_row("row-height: 1.5em;")
        gui_text("Asteroid Spawn Settings")
        gui_row("row-height: 0.5em; background-color: #122048;")
        gui_blank()

        gui_row("row-height: 1.5em;")
        gui_text("$text:Density;")
        # gui_blank()
        asteroid_use_default_density = gui_checkbox("$text:Use Default;")

        gui_row("row-height: 1.5em;")
        asteroid_density = gui_slider("low:0;high:100;text:float;")
        
        gui_row("row-height: 1.5em;")
        gui_text("$text:Shape:;","col-width: content;")

        asteroid_prefabs = labels_get_type("prefab/terrain/asteroid")

        gui_row()
        asteroid_shape_list = gui_list(asteroid_prefabs, select=True)
        with asteroid_shape_list as prefab:
            display_text = prefab.get_inventory_value("display_text")
            if display_text is None:
                display_text = prefab.get_inventory_value("type").replace("prefab/terrain/","").replace("asteroid/","").replace("nebula/","")
            gui_text(f"$text:{display_text};","background-color: #123123")
        asteroid_shape_list.set_selected_index(0)
        
        gui_row("row-height: 1.5em;")
        spawn_asteroid_button = gui_button("$text:Spawn Asteroids")

        on gui_message(spawn_asteroid_button):
            gm = sbs.get_ship_of_client(client_id)
            pos = gamemaster_get_pos(gm)
            size = gamemaster_get_size(gm)
            lbl = asteroid_shape_list.listbox.value
            if not asteroid_use_default_density.value:
                data={"density_scale":asteroid_density.value,"START_X":pos.x,"START_Y":pos.y,"START_Z":pos.z,"SIZE_X":size,"SIZE_Z":size}
            else:
                data={"START_X":pos.x,"START_Y":pos.y,"START_Z":pos.z,"SIZE_X":size,"SIZE_Z":size}
            prefab_spawn(lbl, data=data)

    yield success

