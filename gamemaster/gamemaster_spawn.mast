    with gui_sub_section("row-height: content; background: #000444;"):
        gui_row("row-height: 1.5em;")
        filt = gui_input("$text:;")

        ship_list = filter_ship_data_generically(filt.value, required_roles=["ship"])
        print(f"Ship list length: {len(ship_list)}")

        gui_row("row-height: max-content;")

        items = filter_ship_data_generically("", required_roles=["ship"])
        glb = gui_list_box(items, "", select=True, item_template=gm_ship_spawn_select_template)
        
        on change filt.value:
            items = filter_ship_data_generically(filt.value, required_roles=["ship"])
            glb.items = items
        
        gui_row("row-height: min-content;")
        gui_text("$text:Spawn Side:;justify:center;")
        spawn_side_dropdown = gui_drop_down("$text:Hostile;list:Hostile,Allied,Neutral,Origin;")
        gui_row("row-height: 1.5em;")
        spawn_button = gui_button("$text:Spawn;justify:center;", data={"lb":glb, "spawn_side_dropdown": spawn_side_dropdown}, on_press=gm_spawn_button_pressed)

        gui_row("row-height: 1em;")
        details_search = gui_text("$text:Details;","justify: center; background: #123456; click_text:; click_background: #012345;")
        details_search_row = gui_row("row-height: content;")
        details_search_text = gui_text("$text: No item selected.")
        on change glb.value:
            item = glb.value
            desc = item.get("long_desc","No description found.")
            details_search_text.update(f"$text: {desc}")
        
        on gui_message(details_search):
            if details_search_row.is_hidden_by_script:
                gui_show(details_search_row)
            else:
                gui_hide(details_search_row)


    yield success

=== gm_spawn_button_pressed
    lb = __ITEM__.data.get("lb")
    spawn_side_dropdown = __ITEM__.data.get("spawn_side_dropdown")
    if lb is None or spawn_side_dropdown is None:
        yield fail
    print("Spawning test")
    selection = lb.value
    side_option = spawn_side_dropdown.value
    if side_option == "Origin":
        spawn_side = selection.get("origin","")
    elif side_option == "Allied":
        spawn_side = "tsn" # For now
    elif side_option == "Hostile":
        spawn_side = "raider" # For now
    else:
        spawn_side = "civilian"
    spawn_roles = selection.get("roles","")
    # art = selection.get("artfileroot")
    art = selection.get("key")
    cambot = sbs.get_ship_of_client(client_id)
    pos = gamemaster_get_pos(cambot, "lmb")

    prefab_spawn(prefab_single_ship, data={"ship_role":spawn_roles,"ship_art": art, "side_value": spawn_side}, OFFSET_X=pos.x, OFFSET_Y=pos.y, OFFSET_Z=pos.z)
    ->END

