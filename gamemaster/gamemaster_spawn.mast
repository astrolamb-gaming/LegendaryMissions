=== gm_menu_spawn_ships
metadata: ``` yaml
type: gm_menu/ships
icon_index: 140
icon_color: "blue"
priority: 20 # Smaller number is higher priority
```
    
    data = gm_get_origins_sides_roles()
    origins = data.get("origins")
    origins = sorted(origins, key=str.casefold)
    roles = data.get("roles")
    # NOTE: Sides that are defined in shipData may not be initialized in-game!!
    sides = data.get("sides")
    with gui_sub_section("row-height: content; background: #000444;"):
        gui_row("row-height: 1em;")
        # with gui_sub_section("click_background: #5555;click_text:; background: #1234566b;") as origins_text:
        #     gui_row("row-height: 1em;")
        #     gui_text("$text:Origins;justify:center;")
        origins_text = gm_spawn_type_button("$text:Origins;justify:center;", "background: #012223;")
        origins_row = gui_row("row-height: min-content;")
        selected_style = "click_background: #190182;click_text:; background: #215487;border: 2px; border-color: #349c9c;"
        unselected_style = "click_background: #190182;click_text:; background: #111555;border: 0px;"
        selected_list = list()
        with gui_sub_section("row-height: 1.5em;"):
            with gui_grid(3):
                for o in origins:
                    spawn_filter = gui_text(f"$text:{o};",unselected_style)
                    spawn_filter.data = {"origin":o}
                    on gui_message(spawn_filter):
                        data = __ITEM__.data
                        origin = data.get("origin")
                        print(origin)
                        if __ITEM__ in selected_list:
                            selected_list.remove(__ITEM__)
                            layout_item_update_style(__ITEM__, unselected_style)
                        else:
                            selected_list.append(__ITEM__)
                            layout_item_update_style(__ITEM__, selected_style)
            gui_row()
        # on gui_click(origins_text):
        on gui_message(origins_text):
            if origins_row.is_hidden_by_script:
                gui_show(origins_row)
            else:
                gui_hide(origins_row)

        # A hopefully temporary row to account for a bug in gui_grid.
        # See https://github.com/artemis-sbs/LegendaryMissions/issues/724
        gui_row("row-height: 1em;")
        gui_blank()
        gui_row("row-height: 2px; background: #000000")
        gui_blank()
        gui_row("row-height: max-content;")

        items = filter_ship_data_generically("", required_roles=["ship"])
        lb = gui_list_box(items, "", select=True, item_template=gm_ship_spawn_select_template)
        gui_row("row-height: min-content;")
        gui_text("$text:Spawn Side:;justify:center;")
        # TODO: Spawn sides should always include ALL sides. So we not only need a way to update this list, we also need to dynamically generate it on startup.
        # Current system is acceptable, assuming that all players are on the same side.
        spawn_side_dropdown = gui_drop_down("$text:Origin;list:Origin,Allied,Hostile,Neutral;")
        gui_row("row-height: 1.5em;")
        spawn_button = gui_button("$text:Spawn;justify:center;", data={"lb":lb, "spawn_side_dropdown": spawn_side_dropdown})
        on gui_message(spawn_button):
            print("Spawning test")
            selection = lb.value
            side_option = spawn_side_dropdown.value
            if side_option == "Origin":
                spawn_side = selection.get("origin","")
            elif side_option == "Allied":
                spawn_side = "tsn" # For now
            elif side_option == "Hostile":
                spawn_side = "raider" # For now
            else:
                spawn_side = "civilian"
            spawn_roles = selection.get("roles","")
            # art = selection.get("artfileroot")
            art = selection.get("key")
            cambot = sbs.get_ship_of_client(client_id)
            pos = gamemaster_get_pos(cambot, "lmb")

            prefab_spawn(prefab_single_ship, data={"ship_role":spawn_roles,"ship_art": art, "side_value": spawn_side}, OFFSET_X=pos.x, OFFSET_Y=pos.y, OFFSET_Z=0)

        on change len(selected_list):
            selected_origins = []
            for selected_item in selected_list:
                selected_origins.append(selected_item.data.get("origin"))
            items = filter_ship_data_generically("", required_origin=selected_origins, required_roles=["ship"])
            lb.items = items
            # gui_represent(lb)


        gui_row("row-height: 1em;")
        details = gui_text("$text:Details;","justify: center; background: #123456; click_text:; click_background: #012345;")
        details_row = gui_row("row-height: content;")
        details_text = gui_text("$text: No item selected.")
        on change lb.value:
            item = lb.value
            desc = item.get("long_desc","No description found.")
            details_text.update(f"$text: {desc}")
        
        on gui_message(details):
            if details_row.is_hidden_by_script:
                gui_show(details_row)
            else:
                gui_hide(details_row)
        
    yield success


=== gm_menu_spawn_ships_search
metadata: ```
type: gm_menu/ships/search
