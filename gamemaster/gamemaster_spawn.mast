    data = gm_get_origins_sides_roles()
    origins = data.get("origins")
    roles = data.get("roles")
    # NOTE: Sides that are defined in shipData may not be initialized in-game!!
    sides = data.get("sides")
    with gui_sub_section("row-height: content; background: #000444;"):
        gui_row("row-height: 1em;")
        # with gui_sub_section("click_background: #5555;click_text:; background: #1234566b;") as origins_text:
        #     gui_row("row-height: 1em;")
        #     gui_text("$text:Origins;justify:center;")
        origins_text = gm_spawn_type_button("$text:Origins;justify:center;", "background: #012223;")
        origins_row = gui_row("row-height: min-content;")
        with gui_sub_section("row-height: 1.5em;"):
            with gui_grid(3):
                for o in origins:
                    gui_text(f"$text:{o};","click_background: #5555;click_text:;")
        
        origins_visible = True
        # on gui_click(origins_text):
        on gui_message(origins_text):
            print("Message triggered")
            if origins_visible:
                gui_hide(origins_row)
                origins_visible = False
            else:
                gui_show(origins_row)
                origins_visible = True


        
        gui_row("row-height: 1em;")
        with gui_sub_section("click_background: #5555;click_text:; background: #1234566b;") as role_button:
            gui_row("row-height: 1em;")
            gui_text("$text:Roles;justify:center;")
        
        role_row = gui_row("row-height: min-content;")
        with gui_sub_section("row-height: 1.5em;"):
            with gui_grid(3):
                for r in roles:
                    gui_text(r)

        roles_visible = True
        on gui_message(role_button):
            if roles_visible:
                gui_hide(role_row)
                roles_visible = False
            else:
                gui_show(role_row)
                roles_visible = True

        gui_row("row-height: 1em;color: #111555")
        gui_row("row-height: 1.5em;")
        gui_text("$text:Spawn Side (relative to players):;")
        gui_drop_down("$text:Origin;list:Origin,Allied,Hostile,Neutral")
        gui_row("row-height: content;")

        items = []
        items.append("Test")
        items.append("Test2")
        lb = gui_list_box(items, "", select=True)
        gui_row("row-height: 1.5em;")
        spawn_button = gui_button("Spawn")
        on gui_message(spawn_button):
            print("Spawning test")



        
            
        
    

    # debug_print("Spawn - this should not appear")
    # gui_button("Testing Spawn", f"color: {icon_color}")
