    yield success


=== gm_menu_spawn_ships
metadata: ```
type: gm_menu/spawn/ships
icon_index: 140
```
    gui_row("row-height: 1.5em;")
    filt = gui_input("$text:light;")
    gui_row()

    ship_list = filter_ship_data_generically(filt.value)
    print(f"Ship list length: {len(ship_list)}")

    list_box = gui_list_box(ship_list, "", item_template=gm_ship_spawn_select_template, select=True)

    on change filt.value:
        print("New value: {filt.value}")
        ship_list = filter_ship_data_generically(filt.value)
        list_box.items = ship_list

    # This row shows additional details for the selected ship
    gui_row()
    gui_text(f"Details here....")

    # Spawn row
    gui_row("row-height: 1.5em;")
    spawn_button = gui_button("Spawn")
    on gui_message(spawn_button):
        sel = list_box.get_selected()
        print(f"Spawning: {sel.get('art_id')}")


    yield success



