    with gui_sub_section():
        default gravity_radius = 5000
        default gravity_strength = 4.0
        default turbulence_strength = 2.0
        default collision_damage=200

        gui_row("row-height: 1.5em;")
        bh_name = gui_input("$text:;desc: Naming Black Holes Is Not Currently Functional;")

        gui_row("row-height: 1.5em;")
        gravity_radius_input = gui_input("$text:5000;desc:Gravity Radius;")

        gui_row("row-height: 1.5em;")
        gravity_strength_input = gui_input("$text:4.0;desc: Gravity Strength;")

        gui_row("row-height: 1.5em;")
        turbulence_strength_input = gui_input("$text:2.0;desc: Turbulence Strength;")

        gui_row("row-height: 1.5em;")
        collision_damage_input = gui_input("$text:200;desc: Collision Damage;")

        gui_row("row-height: 1.5em;")
        spawn_black_hole = gui_button("Spawn Black Hole")
        
        on gui_message(spawn_black_hole):
            gravity_radius = safe_int(gravity_radius_input.value, 5000)
            gravity_strength = safe_int(gravity_strength_input.value, 4.0)
            turbulence_strength = safe_int(turbulence_strength_input.value, 2.0)
            collision_damage = safe_int(collision_damage_input.value, 200)

            gm = get_inventory_value(client_id, "GAMEMASTER_COMBOT", None)
            if gm is None:
                debug_print("gm object is None")
                jump END
            pos = gamemaster_get_pos(gm, "lmb")

            bh = await prefab_spawn(prefab_black_hole, data={"gravity_radius": gravity_radius, "gravity_strength": gravity_strength, "turbulence_strength": turbulence_strength, "collision_damage": collision_damage, "START_X": pos.x, "START_Y": pos.y, "START_Z": pos.z})

            #TODO: It seems that black holes currently can't have names.... lame.
            # name = bh_name.value
            # obj = to_object(bh)
            # if name is not None and obj is not None:
            #     obj.set_name(name)

        gui_row()
        gui_blank()

    yield success

